# Development backend image for docker-compose.dev.yml.
# Bind-mounts ./backend at runtime for hot reload. Not for production.
#
# ILMDAS does not need GDAL/PostGIS. Celery and Nginx are not part of local dev.
FROM python:3.12-slim-bookworm

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    DJANGO_SETTINGS_MODULE=config.settings.development \
    ILMDAS_SKIP_ENV_FILE=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd --gid 1001 django && useradd --uid 1001 --gid django -m django \
    && mkdir -p /app && chown -R django:django /app

WORKDIR /app

COPY requirements/ requirements/
# Retries help on flaky PyPI downloads (IncompleteRead / connection resets).
ENV PIP_DEFAULT_TIMEOUT=100 \
    PIP_RETRIES=10
RUN pip install --upgrade pip \
    && pip install --no-cache-dir --retries 10 --timeout 100 \
       -r requirements/development.txt

USER django

# Source is bind-mounted at runtime (./backend:/app).
EXPOSE 8010

CMD ["python", "manage.py", "runserver", "0.0.0.0:8010"]
